{
  "title": "WireGuard",
  "uid": "wireguard-exporter",
  "tags": [
    "wireguard",
    "vpn"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "pessom/wireguard-exporter. Peer names come from the optional wireguard_peer_name metric (docs/prometheus.md).",
  "links": [
    {
      "title": "wireguard-exporter",
      "type": "link",
      "url": "https://github.com/pessom/wireguard-exporter",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(wireguard_scrape_success, job)",
          "refId": "job"
        },
        "definition": "label_values(wireguard_scrape_success, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(wireguard_scrape_success{job=~\"$job\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(wireguard_scrape_success{job=~\"$job\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "interface",
        "label": "Interface",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(wireguard_scrape_success{job=~\"$job\",instance=~\"$instance\"}, interface)",
          "refId": "interface"
        },
        "definition": "label_values(wireguard_scrape_success{job=~\"$job\",instance=~\"$instance\"}, interface)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Interfaces read OK",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(wireguard_scrape_success{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"}) / count(wireguard_scrape_success{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Peers",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(wireguard_device_peers{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Peers with handshake < 3m",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count((time() - wireguard_peer_last_handshake_timestamp_seconds{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"}) < 180) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Peers never connected",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count(wireguard_peer_last_handshake_timestamp_seconds{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"} == 0) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Received",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(rate(wireguard_peer_receive_bytes_total{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"}[$__rate_interval]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Transmitted",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(rate(wireguard_peer_transmit_bytes_total{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"}[$__rate_interval]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Peers",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "(wireguard_peer_info{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"}) * on (public_key) group_left (name) max by (public_key, name) (wireguard_peer_name)\nor on (instance, interface, public_key)\n(wireguard_peer_info{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "(wireguard_peer_last_handshake_timestamp_seconds{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"} * 1000) * on (public_key) group_left (name) max by (public_key, name) (wireguard_peer_name)\nor on (instance, interface, public_key)\n(wireguard_peer_last_handshake_timestamp_seconds{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"} * 1000)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "(rate(wireguard_peer_receive_bytes_total{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"}[$__rate_interval])) * on (public_key) group_left (name) max by (public_key, name) (wireguard_peer_name)\nor on (instance, interface, public_key)\n(rate(wireguard_peer_receive_bytes_total{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"}[$__rate_interval]))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "(rate(wireguard_peer_transmit_bytes_total{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"}[$__rate_interval])) * on (public_key) group_left (name) max by (public_key, name) (wireguard_peer_name)\nor on (instance, interface, public_key)\n(rate(wireguard_peer_transmit_bytes_total{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"}[$__rate_interval]))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "__name__": true,
              "Value #A": true
            },
            "indexByName": {
              "name": 0,
              "public_key": 1,
              "instance": 2,
              "interface": 3,
              "endpoint": 4,
              "allowed_ips": 5,
              "Value #B": 6,
              "Value #C": 7,
              "Value #D": 8
            },
            "renameByName": {
              "Value #B": "Last handshake",
              "Value #C": "Received",
              "Value #D": "Transmitted"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last handshake"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "never"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Received"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Transmitted"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "name"
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Received per peer",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "label_replace(label_replace((rate(wireguard_peer_receive_bytes_total{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"}[$__rate_interval])) * on (public_key) group_left (name) max by (public_key, name) (wireguard_peer_name)\nor on (instance, interface, public_key)\n(rate(wireguard_peer_receive_bytes_total{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"}[$__rate_interval])), \"peer\", \"$1…\", \"public_key\", \"(.{8}).*\"), \"peer\", \"$1\", \"name\", \"(.+)\")",
          "legendFormat": "{{peer}} ({{instance}} {{interface}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Transmitted per peer",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "label_replace(label_replace((rate(wireguard_peer_transmit_bytes_total{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"}[$__rate_interval])) * on (public_key) group_left (name) max by (public_key, name) (wireguard_peer_name)\nor on (instance, interface, public_key)\n(rate(wireguard_peer_transmit_bytes_total{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"}[$__rate_interval])), \"peer\", \"$1…\", \"public_key\", \"(.{8}).*\"), \"peer\", \"$1\", \"name\", \"(.+)\")",
          "legendFormat": "{{peer}} ({{instance}} {{interface}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Time since last handshake",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "label_replace(label_replace((time() - (wireguard_peer_last_handshake_timestamp_seconds{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"} > 0)) * on (public_key) group_left (name) max by (public_key, name) (wireguard_peer_name)\nor on (instance, interface, public_key)\n(time() - (wireguard_peer_last_handshake_timestamp_seconds{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"} > 0)), \"peer\", \"$1…\", \"public_key\", \"(.{8}).*\"), \"peer\", \"$1\", \"name\", \"(.+)\")",
          "legendFormat": "{{peer}} ({{instance}} {{interface}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 180
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Interface read status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "wireguard_scrape_success{job=~\"$job\",instance=~\"$instance\",interface=~\"$interface\"}",
          "legendFormat": "{{instance}} {{interface}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "failed",
                  "color": "red"
                },
                "1": {
                  "text": "ok",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
